# ==============================================================================
# Solar Light Tracking System  (STM32F407 + FreeRTOS + LVGL + CMake)
# Git 忽略规则
# ------------------------------------------------------------------------------
# 原则：只忽略「本机可再生的构建产物 / IDE 个人配置 / 系统垃圾文件」。
#      所有源码、CubeMX 工程文件、第三方库、设计文档必须提交。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 构建输出目录 (CMake / CLion / Ninja)
# ------------------------------------------------------------------------------
/build/
/cmake-build-*/
/out/
/Output/
/cmake-build-debug/
/cmake-build-release/
/cmake-build-relwithdebinfo/

# CMake 在构建目录中生成的中间文件（防止在源码目录内 in-source build）
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
Testing/Temporary/
build.ninja
rules.ninja
.ninja_deps
.ninja_log
Makefile
*.ninja

# ------------------------------------------------------------------------------
# 2. 编译产物 (ARM GCC / 链接输出)
# ------------------------------------------------------------------------------
*.o
*.obj
*.d
*.i
*.a
*.la
*.lo

# 固件与调试输出：可执行文件、ELF、反汇编、链接脚本 map、烧录镜像
*.elf
*.axf
*.out
*.map
*.lst
*.su
*.hex
*.srec
*.mot
*.bin

# ------------------------------------------------------------------------------
# 3. IDE / 编辑器本机配置
# ------------------------------------------------------------------------------
# CLion / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/

# Eclipse / STM32CubeIDE
.settings/
.project
.classpath
.cproject
.launch

# clangd / 索引缓存
.cache/
.clangd/
.clang-format.cache/

# 编辑器临时与备份文件
*~
*.swp
*.swo
*.orig
*.rej
*.bak
*.tmp
*.autosave

# ------------------------------------------------------------------------------
# 4. STM32CubeMX 本机状态
#    .ioc 是工程源文件，必须提交（见文末保留清单）；
#    .mxproject 为 CubeMX 生成的库文件缓存，可随时重建。
#    若希望跨机器同步 CubeMX 的库选择，删除下面这行即可。
# ------------------------------------------------------------------------------
.mxproject

# ------------------------------------------------------------------------------
# 5. 操作系统垃圾文件
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# Linux
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 6. Office 文档临时锁文件 (word/ 下的说明文档本体需要提交)
# ------------------------------------------------------------------------------
~$*.doc
~$*.docx
~$*.xls
~$*.xlsx
~$*.ppt
~$*.pptx

# ------------------------------------------------------------------------------
# 7. 日志与调试转储
# ------------------------------------------------------------------------------
*.log
*.stackdump
*.dmp
core.*

# ------------------------------------------------------------------------------
# 8. Python 辅助脚本产生的缓存（工程构建脚本/工具可能用到）
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ==============================================================================
# 必须被 Git 跟踪的关键文件（显式排除，防止被上面的通配规则误伤）
# ==============================================================================
!Solar_Light_Tracking_System.ioc
!CMakeLists.txt
!CMakePresets.json
!STM32F407XX_FLASH.ld
!startup_stm32f407xx.s
!cmake/gcc-arm-none-eabi.cmake
!cmake/starm-clang.cmake
!cmake/stm32cubemx/CMakeLists.txt
!.gitignore
